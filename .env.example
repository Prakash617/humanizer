# Copy this file to .env and edit values there.
# Never commit .env or put real tokens in this example file.

APP_NAME=AI Humanizer API
APP_VERSION=0.2.0
LOG_LEVEL=INFO

# Inference backend: "local" uses Hugging Face on this machine or Colab.
# "remote" uses an OpenAI-compatible API and does not load a local model.
INFERENCE_BACKEND=local

MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
FALLBACK_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct

# Remote backend (NVIDIA NIM by default). Only used when
# INFERENCE_BACKEND=remote. Keep the key in .env, never in Git.
REMOTE_BASE_URL=https://integrate.api.nvidia.com/v1
REMOTE_MODEL=nvidia/nemotron-3-super-120b-a12b
REMOTE_API_KEY=
REMOTE_TIMEOUT_SECONDS=120
REMOTE_MAX_TOKENS=1024
# Nemotron is a reasoning model. Disable thinking for faster rewriting.
# Leave this empty if your provider rejects chat_template_kwargs.
REMOTE_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# Input and generation limits.
MAX_INPUT_CHARACTERS=8000
MAX_INPUT_TOKENS=6000
MAX_CHUNK_TOKENS=1400
MAX_NEW_TOKENS=1024
TEMPERATURE=0.7
TOP_P=0.8
TOP_K=20
REPETITION_PENALTY=1.1

# Optional Hugging Face token. Leave empty unless a gated/private model requires it.
HF_TOKEN=

# Optional API protection. Set this before using a public tunnel.
# POST /humanize then requires the X-API-Key header.
API_KEY=
